{
  "name": "hearthlog-dev",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build:generated": "hearthlog build",
    "postinstall": "hearthlog build --quiet || echo 'The generated files were not built; run pnpm build:generated'",
    "generate:entities": "hearthlog build",
    "generate:entities:check": "hearthlog build --check",
    "generate:modules": "hearthlog build",
    "generate:modules:check": "hearthlog build --check",
    "compose": "hearthlog build",
    "generate:tenant": "hearthlog build",
    "dev": "hearthlog build && pnpm ledger:provision-local && vite dev",
    "dev:e2e": "hearthlog build && vite dev",
    "build": "hearthlog build && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
    "check:ts": "hearthlog build && svelte-kit sync && tsc --noEmit -p tsconfig.json --skipLibCheck",
    "test:unit": "hearthlog build && vitest",
    "check:modules": "hearthlog build && tsx ../packages/tooling/src/check/check-modules.ts && tsx ../packages/tooling/src/check/check-sdk-exports.ts && tsx ../packages/tooling/src/check/check-layers.ts",
    "check:tenants": "hearthlog build && tsx ../packages/tooling/src/check/check-tenant-config.ts",
    "generate:tenant-schema": "hearthlog build && tsx ../packages/tooling/src/tenants/tenant-schema.ts",
    "generate:icons": "hearthlog build && tsx ../packages/tooling/src/generate/generate-brand-icons.ts",
    "lock:modules": "tsx ../packages/tooling/src/generate/build-generated.ts --all-modules && tsx ../packages/tooling/src/tenants/module-lock.ts",
    "list:sites": "hearthlog build && tsx ../packages/tooling/src/cli/list-sites.ts",
    "hearthlog": "hearthlog",
    "module:new": "tsx ../packages/tooling/src/compose/module-scaffold.ts new",
    "module:export": "tsx ../packages/tooling/src/compose/module-scaffold.ts export",
    "tenant:export": "tsx ../packages/tooling/src/init/export-tenant.ts",
    "ledger:dev": "hearthlog build && wrangler dev --config .generated/shared/ledger/wrangler.jsonc --env-file ledger/.dev.vars --persist-to ledger/.wrangler/state --port 8787",
    "ledger:provision-local": "node --env-file-if-exists=ledger/.dev.vars --import=tsx ../packages/tooling/src/dev/provision-local.ts",
    "ledger:types": "hearthlog build && (cd .generated/shared/ledger && wrangler types ../../../ledger/worker-configuration.d.ts --config wrangler.jsonc --env-file ../../../ledger/.dev.vars.example --strict-vars=false)",
    "ledger:types:check": "hearthlog build && (cd .generated/shared/ledger && wrangler types ../../../ledger/worker-configuration.d.ts --config wrangler.jsonc --env-file ../../../ledger/.dev.vars.example --strict-vars=false --check)",
    "ledger:check": "hearthlog build && pnpm ledger:types:check && tsc --noEmit -p ledger/tsconfig.json && tsc --noEmit -p ../packages/ledger/tsconfig.node.json",
    "ledger:test": "hearthlog build && vitest run --config ../packages/ledger/vitest.config.ts",
    "ledger:dry-run": "hearthlog build && wrangler deploy --config .generated/shared/ledger/wrangler.jsonc --dry-run",
    "ledger:export": "hearthlog build && tsx ../packages/ledger/scripts/logical-backup.ts export",
    "ledger:restore": "hearthlog build && tsx ../packages/ledger/scripts/logical-backup.ts restore",
    "provision:tenants": "hearthlog build && tsx ../packages/tooling/src/deploy/ensure-tenant.ts",
    "ensure:tenant": "hearthlog build && tsx ../packages/tooling/src/deploy/ensure-tenant.ts",
    "ledger:export:tenants": "hearthlog build && tsx ../packages/tooling/src/deploy/backup-tenants.ts",
    "deploy:ledger": "hearthlog build && tsx ../packages/tooling/src/deploy/deploy-ledger.ts",
    "deploy:tenant": "hearthlog build && tsx ../packages/tooling/src/deploy/deploy-tenant.ts",
    "frontend:worker:types": "hearthlog build && (cd .generated/sites/st && wrangler types ../../../../packages/cloudflare/types/worker-configuration.d.ts --config wrangler.jsonc --env-file ../../../.dev.vars.example --strict-vars=false)",
    "frontend:worker:types:check": "hearthlog build && (cd .generated/sites/st && wrangler types ../../../../packages/cloudflare/types/worker-configuration.d.ts --config wrangler.jsonc --env-file ../../../.dev.vars.example --strict-vars=false --check)",
    "frontend:worker:check": "hearthlog build && pnpm frontend:worker:types:check && tsc --noEmit -p tsconfig.worker.json",
    "frontend:worker:dry-run": "hearthlog build && wrangler deploy --config .generated/sites/st/wrangler.jsonc --dry-run",
    "frontend:worker:dry-run:tenant": "hearthlog build && tsx ../packages/tooling/src/deploy/frontend-dry-run.ts",
    "frontend:worker:typecheck": "hearthlog build && tsc --noEmit -p tsconfig.worker.json",
    "calendar:public:check": "hearthlog build && tsc --noEmit -p .generated/shared/calendar-public/tsconfig.json",
    "calendar:public:dry-run": "hearthlog build && wrangler deploy --config .generated/shared/calendar-public/wrangler.jsonc --dry-run",
    "calendar:public:smoke": "hearthlog build && tsx ../packages/tooling/src/public-workers/check-calendar-public-route.ts",
    "apple:ios": "hearthlog apple:ios",
    "apple:mac": "hearthlog apple:mac",
    "apple:test": "hearthlog apple:test",
    "apple:resign": "hearthlog apple:resign"
  },
  "dependencies": {
    "@hearthlog/cloudflare": "workspace:*",
    "@hearthlog/contracts": "workspace:*",
    "@hearthlog/czech": "workspace:*",
    "@hearthlog/generated": "workspace:*",
    "@hearthlog/ledger": "workspace:*",
    "@hearthlog/native": "workspace:*",
    "@hearthlog/runtime": "workspace:*",
    "@hearthlog/sdk": "workspace:*",
    "@hearthlog/shell": "workspace:*",
    "@hearthlog/tooling": "workspace:*",
    "@hearthlog/ui": "workspace:*",
    "@internationalized/date": "^3.12.4",
    "@sinclair/typebox": "0.34.52",
    "@tanstack/svelte-table": "^9.2.8",
    "@tanstack/svelte-virtual": "^3.13.42",
    "bits-ui": "^2.19.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elysia": "1.4.30",
    "jose": "6.2.12",
    "microlighter": "^2.2.0",
    "openapi-types": "12.1.3",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify/json": "^2.2.542",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "date-fns": "^4.4.0",
    "idb": "^8.0.4",
    "kysely": "^0.29.6",
    "sqlocal": "^0.18.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^4.149.0"
  },
  "imports": {
    "#generated/schema": "./.generated/src/schema.generated.ts",
    "#generated/types": "./.generated/src/types.generated.ts",
    "#generated/standard-commands": "./.generated/src/standard-commands.generated.ts",
    "#generated/standard-db": "./.generated/src/standard-db.generated.ts",
    "#generated/module-repositories": "./.generated/src/module-repositories.generated.ts",
    "#generated/modules": "./.generated/src/modules.generated.ts",
    "#generated/module-icons": "./.generated/src/module-icons.generated.ts",
    "#generated/event-schemas": "./.generated/src/event-schemas.generated.ts"
  }
}
