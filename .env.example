# Ledger Service Configuration
# Production and local development use the same-origin gateway. `pnpm dev`
# provisions an ignored, server-only local credential and configures Vite to
# proxy both HTTP and WebSocket traffic to the local Ledger Worker.
VITE_LEDGER_SERVICE_URL=/api/ledger

# Do not define VITE_LEDGER_AUTH_TOKEN for the browser application. The local
# Vite gateway and deployed frontend Worker keep Ledger credentials server-side.

# Optional: Request timeout in milliseconds (default: 5000)
# VITE_LEDGER_TIMEOUT_MS=5000

# Optional: Maximum number of retry attempts (default: 3)
# VITE_LEDGER_MAX_RETRIES=3

# Optional: Enable WebSocket realtime delivery (default: true)
# VITE_LEDGER_ENABLE_REALTIME=true

# Optional: External food catalog URL (default is the public kal API)
# VITE_KAL_API_BASE_URL=https://kal-api.example.workers.dev
