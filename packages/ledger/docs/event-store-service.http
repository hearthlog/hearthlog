@host = http://127.0.0.1:8787
@appToken = replace-with-app-token
@adminToken = replace-with-admin-token
@appId = 11111111-1111-1111-1111-111111111111
@logId = 22222222-2222-2222-2222-222222222222

###
# Public database readiness check
GET {{host}}/health

###
# Runtime: resolve the current app and principal identity
GET {{host}}/session
Authorization: Bearer {{appToken}}

###
# Admin: create an app. Save the returned token; it is shown only once.
POST {{host}}/admin/v1/apps
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "stor"
}

###
# Admin: list apps
GET {{host}}/admin/v1/apps
Authorization: Bearer {{adminToken}}

###
# Admin: read, then replace, an app's event policy
GET {{host}}/admin/v1/apps/{{appId}}/policy
Authorization: Bearer {{adminToken}}

###
PUT {{host}}/admin/v1/apps/{{appId}}/policy
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "contracts": ["org.stor.health"], "dynamicEvents": false, "validation": "enforce" }

###
# Admin: rotate an app token
POST {{host}}/admin/v1/apps/{{appId}}/rotate-token
Authorization: Bearer {{adminToken}}

###
# Admin: revoke an app
POST {{host}}/admin/v1/apps/{{appId}}/revoke
Authorization: Bearer {{adminToken}}

###
# Runtime: list logs in the token's app
GET {{host}}/logs
Authorization: Bearer {{appToken}}

###
# Runtime: create an empty log
POST {{host}}/logs
Content-Type: application/json
Authorization: Bearer {{appToken}}

{
  "name": "personal-ledger"
}

###
# Runtime: fetch log metadata
GET {{host}}/logs/{{logId}}
Authorization: Bearer {{appToken}}

###
# Runtime: create an entity with its first event
POST {{host}}/logs/{{logId}}/events
Content-Type: application/json
Authorization: Bearer {{appToken}}

{
  "requestId": "33333333-3333-3333-3333-333333333333",
  "events": [
    {
      "id": "44444444-4444-4444-4444-444444444444",
      "type": "TRANSACTION_ADDED",
      "entityId": "transaction-1",
      "timestamp": 1717323612903,
      "payload": {
        "id": "55555555-5555-5555-5555-555555555555",
        "name": "Rent",
        "amount": 1200,
        "transaction_status": "active",
        "transaction_category": "housing"
      }
    }
  ]
}

###
# Runtime: update an existing entity currently at entityVersion 1
POST {{host}}/logs/{{logId}}/events
Content-Type: application/json
Authorization: Bearer {{appToken}}

{
  "requestId": "66666666-6666-6666-6666-666666666666",
  "events": [
    {
      "type": "TRANSACTION_UPDATED",
      "entityId": "transaction-1",
      "baseEntityVersion": 1,
      "payload": {
        "transaction_status": "completed"
      }
    }
  ]
}

###
# Runtime: append several events to one entity in a single atomic version chain
POST {{host}}/logs/{{logId}}/events
Content-Type: application/json
Authorization: Bearer {{appToken}}

{
  "requestId": "88888888-8888-4888-8888-888888888888",
  "events": [
    {
      "type": "TRANSACTION_UPDATED",
      "entityId": "transaction-1",
      "baseEntityVersion": 2,
      "payload": { "amount": 1250 }
    },
    {
      "type": "TRANSACTION_COMPLETED",
      "entityId": "transaction-1",
      "baseEntityVersion": 3,
      "payload": { "completed": true }
    }
  ]
}

###
# Runtime: append atomically to two existing entities
POST {{host}}/logs/{{logId}}/events
Content-Type: application/json
Authorization: Bearer {{appToken}}

{
  "requestId": "77777777-7777-7777-7777-777777777777",
  "events": [
    {
      "type": "TRANSACTION_UPDATED",
      "entityId": "transaction-1",
      "baseEntityVersion": 2,
      "payload": { "amount": 1250 }
    },
    {
      "type": "TRANSACTION_UPDATED",
      "entityId": "transaction-2",
      "baseEntityVersion": 1,
      "payload": { "amount": 75 }
    }
  ]
}

###
# Runtime: replay the log after a log version
GET {{host}}/logs/{{logId}}/events?afterVersion=0
Authorization: Bearer {{appToken}}

###
# Runtime: upgrade to a ledger.v1 WebSocket after the local log head
GET {{host}}/logs/{{logId}}/events/socket?afterVersion=0
Authorization: Bearer {{appToken}}
Connection: Upgrade
Upgrade: websocket
Sec-WebSocket-Protocol: ledger.v1

###
# Runtime: delete a log and all child records
DELETE {{host}}/logs/{{logId}}
Authorization: Bearer {{appToken}}
