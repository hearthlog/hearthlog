{
  "name": "@hearthlog/ui",
  "version": "0.13.2",
  "description": "Hearthlog's design system: primitives, overlays, the generic data table, and the small stores they share",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hearthlog/hearthlog.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "src",
    "!**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    "./styles/*.css": "./src/styles/*.css",
    "./assets/*": "./src/assets/*",
    "./*.svelte.js": "./src/*.svelte.ts",
    "./*.js": "./src/*.ts",
    "./*.svelte": "./src/*.svelte"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@tanstack/svelte-table": "^9.2.4",
    "@tanstack/svelte-virtual": "^3.13.39",
    "bits-ui": "^2.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "microlighter": "^2.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  }
}
