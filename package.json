{
  "name": "hearthlog",
  "version": "0.4.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "check:all": "pnpm check:scripts && pnpm test:scripts && pnpm check:examples && pnpm check:packages && pnpm -C dev check:ts && pnpm -C dev test:unit --run && pnpm -C dev build && pnpm -C dev frontend:worker:typecheck && pnpm -C dev calendar:public:check && pnpm -C dev ledger:check && pnpm -C dev ledger:test",
    "check:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "test:scripts": "cd tests/fixture-host && tsx --test ../../packages/tooling/src/security/audit-push.test.ts ../../packages/tooling/src/deploy/async-utils.test.ts ../../packages/tooling/src/public-workers/calendar-public-config.test.ts ../../packages/tooling/src/public-workers/check-gallery-public-route.test.ts ../../packages/tooling/src/deploy/cloudflare-access.test.ts ../../packages/tooling/src/deploy/deployment-security.test.ts ../../packages/tooling/src/deploy/ensure-tenant.test.ts ../../packages/tooling/src/public-workers/gallery-public-config.test.ts ../../packages/tooling/src/tenants/integrations-access.test.ts ../../packages/tooling/src/check/check-layers.test.ts ../../packages/tooling/src/tooling.test.ts ../../packages/tooling/src/move.test.ts ../../packages/tooling/src/init/export-tenant.test.ts ../../packages/tooling/src/init/init.test.ts ../../packages/tooling/src/cli/hearthlog.test.ts ../../packages/tooling/src/compose/compose-modules.test.ts ../../packages/tooling/src/compose/module-scaffold.test.ts ../../packages/tooling/src/deploy/artifact.test.ts ../../packages/tooling/src/tenants/host-configs.test.ts ../../packages/tooling/src/tenants/integrations-config.test.ts ../../packages/tooling/src/tenants/tenant-config-deployment.test.ts ../../packages/tooling/src/tenants/tenant-files.test.ts ../../packages/tooling/src/vite/source-packages.test.ts ../../packages/tooling/src/dev/dev-ledger.test.ts ../../packages/tooling/src/native/swift-types.test.ts",
    "check:layers": "tsx packages/tooling/src/check/check-layers.ts",
    "check:examples": "node packages/tooling/bin/hearthlog.mjs init examples/empty --id empty --modules none --workspace --check",
    "examples:update": "node packages/tooling/bin/hearthlog.mjs init examples/empty --id empty --modules none --workspace --force",
    "check:packages": "tsx scripts/check-packages.ts",
    "check:tarballs": "tsx scripts/tarball-equivalence.ts",
    "test": "playwright test -c tests/playwright.config.ts",
    "test:worker": "playwright test -c tests/playwright.worker.config.ts",
    "test:integration": "tsx scripts/integration.ts",
    "release:version": "tsx scripts/release-version.ts",
    "test:release": "node --test scripts/release/*.test.mjs",
    "publish:packages": "tsx scripts/publish-packages.ts",
    "audit:push": "tsx packages/tooling/src/security/audit-push.ts",
    "audit:forbidden:init": "tsx packages/tooling/src/security/forbidden-init.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@hearthlog/cloudflare": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
