    "ledger:test": "pnpm build:generated && vitest run --config packages/ledger/vitest.config.ts",
    "ledger:dry-run": "pnpm build:generated && wrangler deploy --config .generated/shared/ledger/wrangler.jsonc --dry-run",
    "ledger:export": "pnpm build:generated && tsx packages/ledger/scripts/logical-backup.ts export",
    "ledger:restore": "pnpm build:generated && tsx packages/ledger/scripts/logical-backup.ts restore",
    "provision:tenants": "pnpm build:generated && tsx packages/tooling/src/deploy/ensure-tenant.ts",
    "ensure:tenant": "pnpm build:generated && tsx packages/tooling/src/deploy/ensure-tenant.ts",
    "ledger:export:tenants": "pnpm build:generated && tsx packages/tooling/src/deploy/backup-tenants.ts",
    "deploy:ledger": "pnpm build:generated && tsx packages/tooling/src/deploy/deploy-ledger.ts",
    "deploy:tenant": "pnpm build:generated && tsx packages/tooling/src/deploy/deploy-tenant.ts",
    "tenant:export": "tsx packages/tooling/src/init/export-tenant.ts",
    "check:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "test:scripts": "tsx --test packages/tooling/src/deploy/async-utils.test.ts packages/tooling/src/public-workers/calendar-public-config.test.ts packages/tooling/src/public-workers/check-gallery-public-route.test.ts packages/tooling/src/deploy/cloudflare-access.test.ts packages/tooling/src/deploy/deployment-security.test.ts packages/tooling/src/deploy/ensure-tenant.test.ts packages/tooling/src/public-workers/gallery-public-config.test.ts packages/tooling/src/tenants/integrations-access.test.ts packages/tooling/src/check/check-layers.test.ts packages/tooling/src/tooling.test.ts packages/tooling/src/move.test.ts packages/tooling/src/init/export-tenant.test.ts packages/tooling/src/init/init.test.ts packages/tooling/src/cli/hearthlog.test.ts packages/tooling/src/compose/compose-modules.test.ts packages/tooling/src/compose/module-scaffold.test.ts packages/tooling/src/deploy/artifact.test.ts packages/tooling/src/tenants/host-configs.test.ts packages/tooling/src/tenants/integrations-config.test.ts packages/tooling/src/tenants/tenant-config-deployment.test.ts packages/tooling/src/tenants/tenant-files.test.ts",
    "frontend:worker:types": "pnpm build:generated && (cd .generated/sites/st && wrangler types ../../../packages/cloudflare/types/worker-configuration.d.ts --config wrangler.jsonc --env-file ../../../.dev.vars.example --strict-vars=false)",
    "frontend:worker:types:check": "pnpm build:generated && (cd .generated/sites/st && wrangler types ../../../packages/cloudflare/types/worker-configuration.d.ts --config wrangler.jsonc --env-file ../../../.dev.vars.example --strict-vars=false --check)",
    "frontend:worker:check": "pnpm build:generated && pnpm frontend:worker:types:check && tsc --noEmit -p tsconfig.worker.json",
    "frontend:worker:dry-run": "pnpm build:generated && wrangler deploy --config .generated/sites/st/wrangler.jsonc --dry-run",
    "frontend:worker:dry-run:tenant": "pnpm build:generated && tsx packages/tooling/src/deploy/frontend-dry-run.ts",
    "calendar:public:check": "pnpm build:generated && tsc --noEmit -p .generated/shared/calendar-public/tsconfig.json",
    "calendar:public:dry-run": "pnpm build:generated && wrangler deploy --config .generated/shared/calendar-public/wrangler.jsonc --dry-run",
    "calendar:public:smoke": "pnpm build:generated && tsx packages/tooling/src/public-workers/check-calendar-public-route.ts",
    "list:sites": "pnpm build:generated && tsx packages/tooling/src/cli/list-sites.ts",
    "apple:ios": "node packages/tooling/bin/hearthlog.mjs apple:ios",
    "apple:mac": "node packages/tooling/bin/hearthlog.mjs apple:mac",
    "apple:test": "node packages/tooling/bin/hearthlog.mjs apple:test",
    "apple:resign": "node packages/tooling/bin/hearthlog.mjs apple:resign",
    "check:all": "pnpm check:scripts && pnpm test:scripts && pnpm check:examples && pnpm check:packages && pnpm check:ts && pnpm test:unit --run && pnpm build && pnpm frontend:worker:typecheck && pnpm calendar:public:check && pnpm ledger:check && pnpm ledger:test",
    "build:generated": "tsx packages/tooling/src/generate/build-generated.ts",
    "postinstall": "tsx packages/tooling/src/generate/build-generated.ts --quiet || echo 'The generated files were not built; run pnpm build:generated'",
    "check:packages": "tsx scripts/check-packages.ts",
    "release:version": "tsx scripts/release-version.ts",
    "publish:packages": "tsx scripts/publish-packages.ts",
    "check:tarballs": "tsx scripts/tarball-equivalence.ts",
    "check:examples": "node packages/tooling/bin/hearthlog.mjs init examples/empty --id empty --modules none --workspace --check",
    "examples:update": "node packages/tooling/bin/hearthlog.mjs init examples/empty --id empty --modules none --workspace --force",
    "test:integration": "tsx scripts/integration.ts",
    "frontend:worker:typecheck": "pnpm build:generated && tsc --noEmit -p tsconfig.worker.json"
  },
