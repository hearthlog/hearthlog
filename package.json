    "generate:tenant-schema": "pnpm build:generated && tsx packages/tooling/src/tenants/tenant-schema.ts",
    "dev": "pnpm build:generated && pnpm ledger:provision-local && vite dev",
    "dev:e2e": "pnpm build:generated && vite dev",
    "build": "pnpm build:generated && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:ts": "pnpm build:generated && svelte-kit sync && tsc --noEmit -p tsconfig.json --skipLibCheck",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
    "test": "playwright test",
    "test:worker": "playwright test --config=playwright.worker.config.ts",
    "test:unit": "pnpm build:generated && vitest",
    "ledger:dev": "pnpm build:generated && wrangler dev --config .generated/shared/ledger/wrangler.jsonc --env-file ledger/.dev.vars --persist-to ledger/.wrangler/state --port 8787",
    "ledger:provision-local": "node --env-file-if-exists=ledger/.dev.vars --import=tsx packages/tooling/src/dev/provision-local.ts",
    "ledger:types": "pnpm build:generated && (cd .generated/shared/ledger && wrangler types ../../../ledger/worker-configuration.d.ts --config wrangler.jsonc --env-file ../../../ledger/.dev.vars.example --strict-vars=false)",
    "ledger:types:check": "pnpm build:generated && (cd .generated/shared/ledger && wrangler types ../../../ledger/worker-configuration.d.ts --config wrangler.jsonc --env-file ../../../ledger/.dev.vars.example --strict-vars=false --check)",
