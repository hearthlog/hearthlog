{
  "name": "base",
  "version": "0.4.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "generate:entities:check": "pnpm build:generated --check",
    "generate:entities": "pnpm build:generated",
    "generate:modules": "pnpm build:generated",
    "generate:modules:check": "pnpm build:generated --check",
    "compose": "pnpm build:generated",
    "check:modules": "pnpm build:generated && tsx packages/tooling/src/check/check-modules.ts && tsx packages/tooling/src/check/check-sdk-exports.ts && tsx packages/tooling/src/check/check-layers.ts",
    "check:layers": "pnpm build:generated && tsx packages/tooling/src/check/check-layers.ts",
    "generate:tenant": "pnpm build:generated",
    "generate:icons": "pnpm build:generated && tsx packages/tooling/src/generate/generate-brand-icons.ts",
    "module:new": "tsx packages/tooling/src/compose/module-scaffold.ts new",
    "module:export": "tsx packages/tooling/src/compose/module-scaffold.ts export",
    "audit:push": "tsx packages/tooling/src/security/audit-push.ts",
    "audit:forbidden:init": "tsx packages/tooling/src/security/forbidden-init.ts",
    "hearthlog": "pnpm build:generated && tsx packages/tooling/src/cli/hearthlog.ts",
