# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-temporary-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
.dev.vars

# SvelteKit specific
.svelte-kit/
build/

# Vite specific
dist/
.vite/

# Cloudflare Wrangler
.wrangler/
# Stray output of a bare `wrangler types` run from the repo root; the
# committed worker types live in worker/worker-configuration.d.ts.
/worker-configuration.d.ts

# Local design-review and verification artifacts
/.svelte-kit-*/
/output/
/tmp/

# IDE directories
.idea/
.vscode/

# DS_Store for macOS
.DS_Store

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

.gemini/
gha-creds-*.json


# Native apps (packages/native): build output, the generated iOS project, and personal device settings
.apple-build/
resign.local.json

# Local evaluation exports (personal finance data)
.eval/

# Module routes composed per tenant by pnpm compose
src/routes/(modules)/
src/module-sources.generated.css

# What `pnpm build:generated` writes (the catalog, entity code, and per-site files); only its package.json is committed
/.generated/*
!/.generated/package.json

# The seal of a tenant release build (hearthlog artifact manifest)
/artifact-manifest.json

# The short-lived copy Worker of a tenant move (hearthlog split files)
/wrangler.tenant-move.jsonc
