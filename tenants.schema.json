{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hearthlog tenants",
  "description": "Generated by packages/tooling/src/tenants/tenant-schema.ts; do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "infrastructure"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledgerWorker",
        "invoicePdfsBucket",
        "calendarFeedsBucket",
        "calendarPublicWorker",
        "calendarPublicOrigin",
        "galleryFilesBucket",
        "galleryPublicBucket",
        "galleryPublicWorker",
        "galleryPublicOrigin",
        "workersDevDomain",
        "ledgerAdminEmail",
        "accessTeamDomain"
      ],
      "properties": {
        "ledgerWorker": {
          "type": "string",
          "minLength": 1
        },
        "invoicePdfsBucket": {
          "type": "string",
          "minLength": 1
        },
        "calendarFeedsBucket": {
          "type": "string",
          "minLength": 1
        },
        "calendarPublicWorker": {
          "type": "string",
          "minLength": 1
        },
        "calendarPublicOrigin": {
          "type": "string",
          "pattern": "^https://[^/?#@]+/?$"
        },
        "galleryFilesBucket": {
          "type": "string",
          "minLength": 1
        },
        "galleryPublicBucket": {
          "type": "string",
          "minLength": 1
        },
        "galleryPublicWorker": {
          "type": "string",
          "minLength": 1
        },
        "galleryPublicOrigin": {
          "type": "string",
          "pattern": "^https://[^/?#@]+/?$"
        },
        "workersDevDomain": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*\\.workers\\.dev$",
          "description": "The account's workers.dev subdomain."
        },
        "invoiceRendererOrigin": {
          "type": "string",
          "pattern": "^https://[^/?#@]+/?$"
        },
        "kalApiOrigin": {
          "type": "string",
          "pattern": "^https://[^/?#@]+/?$"
        },
        "ledgerAdminEmail": {
          "type": "string",
          "format": "email"
        },
        "accessTeamDomain": {
          "type": "string",
          "pattern": "^https://[^/?#@]+/?$"
        },
        "accessSessionDuration": {
          "type": "string",
          "pattern": "^[1-9][0-9]*h$",
          "description": "Whole hours between 1h and 720h."
        },
        "accessGlobalSessionDuration": {
          "type": "string",
          "pattern": "^[1-9][0-9]*h$",
          "description": "Whole hours between 1h and 720h."
        },
        "accountId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "The Cloudflare account that holds the shared stack."
        },
        "gallerySweeper": {
          "type": "string",
          "description": "The shared-stack site that sweeps the public Gallery bucket; the first by id when unset."
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "enum": [
              "calendar",
              "calc",
              "finance",
              "gallery",
              "bmi",
              "calories",
              "activities",
              "invoices"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "home": {
          "enum": [
            "/",
            "/developer",
            "/calendar",
            "/calc",
            "/finance",
            "/gallery",
            "/bmi",
            "/calories",
            "/activities",
            "/invoices"
          ],
          "description": "Start path; must belong to an enabled feature."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "developerNavVisible": {
          "type": "boolean"
        },
        "entitiesNavVisible": {
          "type": "boolean"
        }
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "authorizedEmails"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Becomes the wrangler env, the Worker name and the workers.dev hostname."
          },
          "ledgerAppName": {
            "type": "string",
            "minLength": 1
          },
          "admin": {
            "type": "boolean"
          },
          "authorizedEmails": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "features": {
            "type": "array",
            "items": {
              "enum": [
                "calendar",
                "calc",
                "finance",
                "gallery",
                "bmi",
                "calories",
                "activities",
                "invoices"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "home": {
            "enum": [
              "/",
              "/developer",
              "/calendar",
              "/calc",
              "/finance",
              "/gallery",
              "/bmi",
              "/calories",
              "/activities",
              "/invoices"
            ],
            "description": "Start path; must belong to an enabled feature."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "developerNavVisible": {
            "type": "boolean"
          },
          "entitiesNavVisible": {
            "type": "boolean"
          },
          "ai": {
            "type": "array",
            "items": {
              "enum": [
                "category-pick",
                "invoice-expense-type"
              ]
            },
            "uniqueItems": true
          },
          "integrations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "logId"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                },
                "kind": {
                  "enum": [
                    "steps"
                  ]
                },
                "logId": {
                  "type": "string",
                  "format": "uuid"
                },
                "clientId": {
                  "type": "string",
                  "description": "Access service-token client id; inactive until set."
                }
              }
            }
          },
          "dynamicEntities": {
            "type": "boolean"
          },
          "theme": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "accent": {
                "type": "string",
                "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              }
            }
          },
          "hostname": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
